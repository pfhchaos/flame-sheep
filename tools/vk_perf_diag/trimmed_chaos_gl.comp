#version 430 core
// GL flavor of trimmed_chaos_vk.comp — same intent + same operations,
// but with the OpenGL conventions (uniforms instead of push constants,
// version 430 instead of 450). Run through moderngl to get Mesa's
// iris-driver ISA dump for the same chaos-game pattern.
//
// The only structural differences from the Vulkan version that would
// affect codegen:
//   - Uniforms vs push constants (different memory subsystem on Intel
//     GPUs — uniforms go through constant cache, push constants land
//     in a register-mapped area)
//   - Different binding numbering convention
// The compute body (the atomicAdd-inside-loop pattern) is identical
// — that's the thing whose ISA we want to compare.

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Histogram {
    uint histogram[];
};
layout(std430, binding = 1) buffer Walkers {
    float walker_data[];
};

uniform int   u_width;
uniform int   u_height;
uniform int   u_iterations;
uniform uint  u_rng_seed;

uint rng_state;
uint rng_next() {
    rng_state ^= rng_state << 13u;
    rng_state ^= rng_state >> 17u;
    rng_state ^= rng_state << 5u;
    return rng_state;
}
float rng_float() { return float(rng_next()) / float(0xFFFFFFFFu); }

void main() {
    uint gid = gl_GlobalInvocationID.x;
    rng_state = gid * 1973u + 9277u + u_rng_seed;

    uint base = gid * 3u;
    float px = walker_data[base + 0u];
    float py = walker_data[base + 1u];

    for (int iter = 0; iter < u_iterations; iter++) {
        int x = int((px + 1.0) * 0.5 * float(u_width));
        int y = int((py + 1.0) * 0.5 * float(u_height));
        if (x >= 0 && x < u_width && y >= 0 && y < u_height) {
            uint idx = uint(y * u_width + x);
            atomicAdd(histogram[idx], 1u);
        }
        px += (rng_float() - 0.5) * 0.01;
        py += (rng_float() - 0.5) * 0.01;
    }

    walker_data[base + 0u] = px;
    walker_data[base + 1u] = py;
}
