#version 430 core

// ============================================================
// flame.comp — chaos game compute shader
// ============================================================
// Each invocation is one "walker" running the chaos game.
// Walkers are independent — no communication needed (unlike
// some CUDA workloads). This is embarrassingly parallel.
//
// CUDA equivalent mental model:
//   gridDim  = gl_NumWorkGroups      (how many blocks)
//   blockDim = gl_WorkGroupSize      (threads per block) = local_size below
//   blockIdx = gl_WorkGroupID
//   threadIdx= gl_LocalInvocationID
//   global thread id = gl_GlobalInvocationID
// ============================================================

// 64 threads per workgroup — like CUDA blockDim.x = 64
// renderer.py dispatches (N_WALKERS / 64) workgroups
layout(local_size_x = 64) in;

// ------------------------------------------------------------
// Histogram SSBO
// Two parallel uint arrays — we use uints so we can atomicAdd.
// Floats don't support atomics in base OpenGL.
//
// hit_count[i]    — how many times pixel i was hit
// color_acc[i]    — color accumulator (scaled to uint, 0..1 → 0..1000000)
//
// Pixel index: i = py * width + px
// ------------------------------------------------------------
// Packed as a single unsized array — only the last member of an SSBO
// can be unsized. Layout:
//   [0          .. n_pixels-1] = hit_count
//   [n_pixels   .. 2*n_pixels-1] = color_acc
// where n_pixels = u_width * u_height
layout(std430, binding = 0) buffer Histogram {
    uint histogram[];  // length = width * height * 2
};

// ------------------------------------------------------------
// Walker state SSBO — each walker has its own (x, y, color)
// Persists between dispatches so walkers stay on the attractor
// ------------------------------------------------------------
layout(std430, binding = 1) buffer Walkers {
    // Packed: [x, y, color] per walker, stride 3
    float walker_data[];
};

// ------------------------------------------------------------
// Genome uniforms
// ------------------------------------------------------------
#define MAX_TRANSFORMS 6
#define NUM_VARIATIONS 30

// Large arrays via SSBOs (bindings 2, 3) — more reliable than uniform arrays
// in OpenGL for arbitrary sizes, and avoids driver uniform limits.
//
// Affines: [a,b,c,d,e,f] per transform, flat — index as [tidx*6 + coeff]
// Variations: [w0..w29] per transform, flat — index as [tidx*NUM_VARIATIONS + var]
layout(std430, binding = 2) readonly buffer Affines {
    float u_affines[];   // length = MAX_TRANSFORMS * 6
};
layout(std430, binding = 3) readonly buffer Variations {
    float u_variations[];  // length = MAX_TRANSFORMS * NUM_VARIATIONS
};

// Color index per transform (0..1)
layout(std430, binding = 4) readonly buffer Colors {
    float u_colors[];
};

// Probability weights (pre-normalized on CPU)
layout(std430, binding = 5) readonly buffer Weights {
    float u_weights[];
};

uniform int   u_n_transforms;
uniform float u_zoom;
uniform float u_rotation;
uniform vec2  u_center;
uniform int   u_width;
uniform int   u_height;
uniform int   u_iterations;   // chaos game steps per invocation

// Color scaling factor for uint accumulator
#define COLOR_SCALE 1000000u

// ------------------------------------------------------------
// Pseudo-random number generator
// We need per-invocation randomness. No stdlib rand() in GLSL.
// This is a simple hash-based LCG seeded from invocation ID + position.
// Good enough for the chaos game — we just need "random enough".
// ------------------------------------------------------------
uint rng_state;

void rng_seed(uint seed) {
    rng_state = seed;
}

uint rng_next() {
    // Xorshift32 — fast, decent quality
    rng_state ^= rng_state << 13u;
    rng_state ^= rng_state >> 17u;
    rng_state ^= rng_state << 5u;
    return rng_state;
}

float rng_float() {
    // 0..1
    return float(rng_next()) / float(0xFFFFFFFFu);
}

// ------------------------------------------------------------
// Variation functions
// Applied after affine transform to warp the point nonlinearly.
// Each function takes (x,y) and r²=x²+y², returns warped (x,y).
// 'w' is the variation weight.
// ------------------------------------------------------------

// Helper: r squared and r
float r2(vec2 p) { return dot(p, p); }
float r(vec2 p)  { return length(p); }
// atan2 — GLSL has atan(y,x) builtin
float theta(vec2 p) { return atan(p.x, p.y); }  // note: x/y intentional per flam3 spec
float phi(vec2 p)   { return atan(p.y, p.x); }

vec2 var_linear(vec2 p, float w)       { return w * p; }
vec2 var_sinusoidal(vec2 p, float w)   { return w * sin(p); }
vec2 var_spherical(vec2 p, float w)    { return w * p / max(r2(p), 1e-6); }
vec2 var_swirl(vec2 p, float w) {
    float rr = r2(p);
    return w * vec2(p.x * sin(rr) - p.y * cos(rr),
                    p.x * cos(rr) + p.y * sin(rr));
}
vec2 var_horseshoe(vec2 p, float w) {
    float ri = w / max(r(p), 1e-6);
    return ri * vec2((p.x - p.y) * (p.x + p.y), 2.0 * p.x * p.y);
}
vec2 var_polar(vec2 p, float w) {
    return w * vec2(theta(p) / 3.14159265, r(p) - 1.0);
}
vec2 var_handkerchief(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    return w * ri * vec2(sin(th + ri), cos(th - ri));
}
vec2 var_heart(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    return w * ri * vec2(sin(th * ri), -cos(th * ri));
}
vec2 var_disk(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    float piri = 3.14159265 * ri;
    return w * (th / 3.14159265) * vec2(sin(piri), cos(piri));
}
vec2 var_spiral(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    return (w / max(ri, 1e-6)) * vec2(cos(th) + sin(ri), sin(th) - cos(ri));
}
vec2 var_hyperbolic(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    return w * vec2(sin(th) / max(ri, 1e-6), cos(th) * ri);
}
vec2 var_diamond(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    return w * vec2(sin(th) * cos(ri), cos(th) * sin(ri));
}
vec2 var_ex(vec2 p, float w) {
    float th = theta(p); float ri = r(p);
    float p0 = sin(th + ri); float p1 = cos(th - ri);
    return w * ri * vec2(p0*p0*p0 + p1*p1*p1, p0*p0*p0 - p1*p1*p1);
}
vec2 var_julia(vec2 p, float w) {
    float sqr = w * sqrt(r(p));
    float th  = theta(p) * 0.5;
    // random sign flip — use rng for authentic julia behavior
    if (rng_next() % 2u == 0u) th += 3.14159265;
    return sqr * vec2(cos(th), sin(th));
}
vec2 var_bent(vec2 p, float w) {
    vec2 q = p;
    if (q.x < 0.0) q.x *= 2.0;
    if (q.y < 0.0) q.y *= 0.5;
    return w * q;
}
vec2 var_waves(vec2 p, float w, int tidx) {
    // uses affine b,c,e,f coefficients — reuse from transform
    float b = u_affines[tidx*6 + 1];
    float c = u_affines[tidx*6 + 2];
    float e = u_affines[tidx*6 + 4];
    float f = u_affines[tidx*6 + 5];
    return w * vec2(p.x + b * sin(p.y / max(c*c, 1e-6)),
                    p.y + e * sin(p.x / max(f*f, 1e-6)));
}
vec2 var_fisheye(vec2 p, float w) {
    float ri = 2.0 / (r(p) + 1.0);
    return w * ri * vec2(p.y, p.x);  // note x/y swap
}
vec2 var_popcorn(vec2 p, float w, int tidx) {
    float c = u_affines[tidx*6 + 2];
    float f = u_affines[tidx*6 + 5];
    return w * vec2(p.x + c * sin(tan(3.0 * p.y)),
                    p.y + f * sin(tan(3.0 * p.x)));
}
vec2 var_exponential(vec2 p, float w) {
    return w * exp(p.x - 1.0) * vec2(cos(3.14159265 * p.y), sin(3.14159265 * p.y));
}
vec2 var_power(vec2 p, float w) {
    return w * pow(r(p), sin(theta(p))) * vec2(cos(theta(p)), sin(theta(p)));
}
vec2 var_cosine(vec2 p, float w) {
    return w * vec2(cos(3.14159265 * p.x) * cosh(p.y),
                   -sin(3.14159265 * p.x) * sinh(p.y));
}
// Remaining variations — simpler implementations
vec2 var_rings(vec2 p, float w, int tidx) {
    float c = u_affines[tidx*6 + 2];
    float cc = c * c + 1e-6;
    float ri = r(p);
    float th = theta(p);
    float rr = mod(ri + cc, 2.0 * cc) - cc + ri * (1.0 - cc);
    return w * rr * vec2(cos(th), sin(th));
}
vec2 var_fan(vec2 p, float w, int tidx) {
    float c = u_affines[tidx*6 + 2];
    float f = u_affines[tidx*6 + 5];
    float th = theta(p); float ri = r(p);
    float t = 3.14159265 * c * c + 1e-6;
    float th2 = (mod(th + f, 2.0*t) > t) ? th - t : th + t;
    return w * ri * vec2(cos(th2), sin(th2));
}
vec2 var_eyefish(vec2 p, float w)  { return w * 2.0 / (r(p) + 1.0) * p; }
vec2 var_bubble(vec2 p, float w)   { return w * 4.0 / (r2(p) + 4.0) * p; }
vec2 var_cylinder(vec2 p, float w) { return w * vec2(sin(p.x), p.y); }

// blob variation — has extra parameters but we approximate
vec2 var_blob(vec2 p, float w) {
    float ri = r(p); float th = theta(p);
    // simplified blob (no extra params)
    float rr = ri * (0.5 + 0.5 * sin(5.0 * th));
    return w * rr * vec2(cos(th), sin(th));
}
vec2 var_pdj(vec2 p, float w) {
    // PDJ params — use fixed values for now, TODO: add as uniforms
    float a=1.4, b=2.3, c=2.4, d=2.2;
    return w * vec2(sin(a * p.y) - cos(b * p.x),
                    sin(c * p.x) - cos(d * p.y));
}
vec2 var_fan2(vec2 p, float w) {
    float ri = r(p); float th = theta(p);
    float px=3.14159265*0.5, py=0.5;  // simplified
    float t = th + py - px * floor((th + py) / px);
    float th2 = (t > px * 0.5) ? th - t + px*0.5 : th + t - px*0.5;  // simplified
    return w * ri * vec2(sin(th2), cos(th2));
}
vec2 var_rings2(vec2 p, float w) {
    float ri = r(p); float th = theta(p);
    float v = 0.5;  // simplified
    float rr = ri - 2.0*v * floor((ri + v) / (2.0*v)) + ri*(1.0-v);
    return w * rr * vec2(cos(th), sin(th));
}

// ------------------------------------------------------------
// Apply all variations for transform tidx, blending by weight
// ------------------------------------------------------------
vec2 apply_variations(vec2 p, int tidx) {
    vec2 result = vec2(0.0);
    int base = tidx * NUM_VARIATIONS;

    // Each variation: if weight > 0, compute and add weighted result
    // This is verbose but the compiler will eliminate zero-weight branches
    float w;

    w = u_variations[base +  0]; if (w > 0.0) result += var_linear(p, w);
    w = u_variations[base +  1]; if (w > 0.0) result += var_sinusoidal(p, w);
    w = u_variations[base +  2]; if (w > 0.0) result += var_spherical(p, w);
    w = u_variations[base +  3]; if (w > 0.0) result += var_swirl(p, w);
    w = u_variations[base +  4]; if (w > 0.0) result += var_horseshoe(p, w);
    w = u_variations[base +  5]; if (w > 0.0) result += var_polar(p, w);
    w = u_variations[base +  6]; if (w > 0.0) result += var_handkerchief(p, w);
    w = u_variations[base +  7]; if (w > 0.0) result += var_heart(p, w);
    w = u_variations[base +  8]; if (w > 0.0) result += var_disk(p, w);
    w = u_variations[base +  9]; if (w > 0.0) result += var_spiral(p, w);
    w = u_variations[base + 10]; if (w > 0.0) result += var_hyperbolic(p, w);
    w = u_variations[base + 11]; if (w > 0.0) result += var_diamond(p, w);
    w = u_variations[base + 12]; if (w > 0.0) result += var_ex(p, w);
    w = u_variations[base + 13]; if (w > 0.0) result += var_julia(p, w);
    w = u_variations[base + 14]; if (w > 0.0) result += var_bent(p, w);
    w = u_variations[base + 15]; if (w > 0.0) result += var_waves(p, w, tidx);
    w = u_variations[base + 16]; if (w > 0.0) result += var_fisheye(p, w);
    w = u_variations[base + 17]; if (w > 0.0) result += var_popcorn(p, w, tidx);
    w = u_variations[base + 18]; if (w > 0.0) result += var_exponential(p, w);
    w = u_variations[base + 19]; if (w > 0.0) result += var_power(p, w);
    w = u_variations[base + 20]; if (w > 0.0) result += var_cosine(p, w);
    w = u_variations[base + 21]; if (w > 0.0) result += var_rings(p, w, tidx);
    w = u_variations[base + 22]; if (w > 0.0) result += var_fan(p, w, tidx);
    w = u_variations[base + 23]; if (w > 0.0) result += var_blob(p, w);
    w = u_variations[base + 24]; if (w > 0.0) result += var_pdj(p, w);
    w = u_variations[base + 25]; if (w > 0.0) result += var_fan2(p, w);
    w = u_variations[base + 26]; if (w > 0.0) result += var_rings2(p, w);
    w = u_variations[base + 27]; if (w > 0.0) result += var_eyefish(p, w);
    w = u_variations[base + 28]; if (w > 0.0) result += var_bubble(p, w);
    w = u_variations[base + 29]; if (w > 0.0) result += var_cylinder(p, w);

    return result;
}

// ------------------------------------------------------------
// Select transform index by weighted random choice
// ------------------------------------------------------------
int pick_transform(float rand_val) {
    float cumulative = 0.0;
    for (int i = 0; i < u_n_transforms; i++) {
        cumulative += u_weights[i];
        if (rand_val < cumulative) return i;
    }
    return u_n_transforms - 1;  // fallback for float precision edge
}

// ------------------------------------------------------------
// World → screen pixel mapping
// ------------------------------------------------------------
ivec2 world_to_pixel(vec2 p) {
    // Apply global zoom and rotation
    float cosR = cos(u_rotation);
    float sinR = sin(u_rotation);
    vec2 rotated = vec2(cosR * p.x - sinR * p.y,
                        sinR * p.x + cosR * p.y);
    vec2 scaled = (rotated - u_center) * u_zoom;

    // Map (-1..1) world space → pixel coords
    int px = int((scaled.x + 1.0) * 0.5 * float(u_width));
    int py = int((scaled.y + 1.0) * 0.5 * float(u_height));
    return ivec2(px, py);
}

// ============================================================
// Main — each invocation is one walker
// ============================================================
void main() {
    uint gid = gl_GlobalInvocationID.x;

    // Seed RNG from invocation ID — each walker gets different randomness
    rng_seed(gid * 1973u + 9277u);

    // Load this walker's state from SSBO
    // Layout: [x0, y0, c0,  x1, y1, c1, ...]
    uint base = gid * 3u;
    float px = walker_data[base + 0u];
    float py = walker_data[base + 1u];
    float pc = walker_data[base + 2u];

    // Chaos game
    for (int iter = 0; iter < u_iterations; iter++) {

        // 1. Pick a transform
        int tidx = pick_transform(rng_float());

        // 2. Apply affine transform
        //    x' = a*x + b*y + c
        //    y' = d*x + e*y + f
        int abase = tidx * 6;
        float nx = u_affines[abase+0]*px + u_affines[abase+1]*py + u_affines[abase+2];
        float ny = u_affines[abase+3]*px + u_affines[abase+4]*py + u_affines[abase+5];

        // 3. Apply variation functions
        vec2 warped = apply_variations(vec2(nx, ny), tidx);
        px = warped.x;
        py = warped.y;

        // 4. Blend color toward this transform's color
        pc = (pc + u_colors[tidx]) * 0.5;

        // 5. Plot — skip first 20 iterations (fuse, not on attractor yet)
        if (iter < 20) continue;

        // 6. Map to pixel
        ivec2 pixel = world_to_pixel(vec2(px, py));

        // Bounds check — point may be outside viewport
        if (pixel.x < 0 || pixel.x >= u_width ||
            pixel.y < 0 || pixel.y >= u_height) continue;

        // 7. Accumulate into histogram (atomic — safe from all threads)
        uint idx = uint(pixel.y * u_width + pixel.x);
        uint n_pixels = uint(u_width * u_height);
        atomicAdd(histogram[idx],            1u);                          // hit_count
        atomicAdd(histogram[n_pixels + idx], uint(pc * float(COLOR_SCALE))); // color_acc
    }

    // Save walker state for next dispatch
    walker_data[base + 0u] = px;
    walker_data[base + 1u] = py;
    walker_data[base + 2u] = pc;
}
