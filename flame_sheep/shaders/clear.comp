#version 430 core
// Clear the histogram SSBO — much faster than CPU upload
// Run with ceil(n_pixels*2 / 64) workgroups
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Histogram {
    uint histogram[];
};

uniform int u_size;  // total length = width * height * 2

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < uint(u_size)) {
        histogram[idx] = 0u;
    }
}
