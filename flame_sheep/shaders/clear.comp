#version 430 core
// Decay the histogram SSBO — multiply all values by (decay_num/256)
// When decay_num == 0, this is a full clear.
// Run with ceil(n_pixels*2 / 64) workgroups
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Histogram {
    uint histogram[];
};

uniform int u_size;       // total length = width * height * 2
uniform uint u_decay_num; // numerator / 256, e.g. 230 ≈ 0.9 retention

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < uint(u_size)) {
        if (u_decay_num == 0u) {
            histogram[idx] = 0u;
        } else {
            histogram[idx] = (histogram[idx] * u_decay_num) >> 8u;
        }
    }
}
