#version 430 core

// ============================================================
// density_estimation.comp — flam3-style adaptive density estimation
// ============================================================
// Scatter approach:
//   1. For each pixel with hits, compute local density
//   2. Map density → kernel width (high density = sharp)
//   3. Scatter log-scaled hits with Gaussian kernel
//   4. Scatter color index (0-1) weighted by same kernel
//      to preserve color_idx = color_acc / hits after scatter
//
// Output layout differs from input:
//   hits channel:  accumulated log-density (fixed-point × HITS_SCALE)
//   color channel: accumulated color_idx weighted by hits (fixed-point × COLOR_OUT_SCALE)
// Tonemap reconstructs color_idx = color_channel / hits_channel (scales cancel)
// ============================================================

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 11) readonly buffer InputHistogram {
    uint in_histogram[];  // [hits_0..hits_n, colors_0..colors_n]
};

layout(std430, binding = 12) coherent buffer OutputHistogram {
    uint out_histogram[];
};

uniform int u_width;
uniform int u_height;
uniform int u_max_radius;
uniform float u_curve;

// Input COLOR_SCALE (must match flame.comp)
#define COLOR_SCALE 1000000.0

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= u_width || pos.y >= u_height) return;

    uint n_pixels = uint(u_width * u_height);
    uint center_idx = uint(pos.y * u_width + pos.x);

    float center_hits = float(in_histogram[center_idx]);
    if (center_hits < 0.5) return;

    // Don't scatter very sparse pixels — they're noise, not structure.
    // flam3 doesn't need this because it oversamples 4×, making
    // background pixels truly zero. We compensate by thresholding.
    // Threshold: skip if local 3×3 density is below ~1% of max density.
    // We compute this cheaply by checking the center pixel alone first.
    // The kernel width calc below handles the rest adaptively.

    float center_color_acc = float(in_histogram[n_pixels + center_idx]);

    // --- Local density (3×3 neighborhood) ---
    float f_select = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            int ix = pos.x + dx;
            int iy = pos.y + dy;
            if (ix < 0 || ix >= u_width || iy < 0 || iy >= u_height) continue;
            f_select += float(in_histogram[uint(iy * u_width + ix)]);
        }
    }
    f_select /= 9.0;

    // --- Kernel width ---
    float filt_h = float(u_max_radius) / pow(f_select + 1.0, u_curve);
    filt_h = clamp(filt_h, 0.5, float(u_max_radius));
    int r = int(ceil(filt_h));

    float sigma = filt_h / 2.5;
    float sigma2_inv = 1.0 / (2.0 * sigma * sigma);

    // Extract color index (0-1)
    float color_idx = center_color_acc / (center_hits * COLOR_SCALE);
    color_idx = clamp(color_idx, 0.0, 1.0);

    // Normalize kernel so total scattered energy = source energy.
    // Without this, every source adds unscaled, and backgrounds blow up.
    float kernel_sum = 0.0;
    for (int dy = -r; dy <= r; dy++) {
        for (int dx = -r; dx <= r; dx++) {
            float d2 = float(dx * dx + dy * dy);
            if (d2 > filt_h * filt_h) continue;
            int ix = pos.x + dx;
            int iy = pos.y + dy;
            if (ix < 0 || ix >= u_width || iy < 0 || iy >= u_height) continue;
            kernel_sum += exp(-d2 * sigma2_inv);
        }
    }
    if (kernel_sum < 1e-6) kernel_sum = 1.0;
    float inv_kernel = 1.0 / kernel_sum;

    // --- Scatter ---
    // Each source pixel distributes its log-scaled value across neighbors.
    // kernel weights sum to 1 → total energy is preserved.
    for (int dy = -r; dy <= r; dy++) {
        for (int dx = -r; dx <= r; dx++) {
            float d2 = float(dx * dx + dy * dy);
            if (d2 > filt_h * filt_h) continue;

            int ix = pos.x + dx;
            int iy = pos.y + dy;
            if (ix < 0 || ix >= u_width || iy < 0 || iy >= u_height) continue;

            float w = exp(-d2 * sigma2_inv) * inv_kernel;
            uint dst_idx = uint(iy * u_width + ix);

            // Scatter both channels with same kernel weights (linear space).
            // Log-density mapping happens in tonemap afterward.
            // color_idx = color_acc/(hits*COLOR_SCALE) is preserved since
            // both are weighted by the same kernel.
            uint hits_contrib  = uint(center_hits * w + 0.5);
            uint color_contrib = uint(center_color_acc * w + 0.5);

            if (hits_contrib > 0u)
                atomicAdd(out_histogram[dst_idx], hits_contrib);
            if (color_contrib > 0u)
                atomicAdd(out_histogram[n_pixels + dst_idx], color_contrib);
        }
    }
}
